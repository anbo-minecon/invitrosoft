# ========================================
# CONFIGURACIÓN DE BASE DE DATOS
# ========================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_secure_password
DB_NAME=invitrosoft

# ========================================
# CONFIGURACIÓN DE CORREO (Gmail SMTP)
# ========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password_here
MAIL_FROM=noreply@invitrosoft.com
MAIL_FROM_NAME=InvitroSoft

# ========================================
# CONFIGURACIÓN DE APLICACIÓN
# ========================================
APP_ENV=development
APP_DEBUG=false
APP_URL=http://localhost/invitrosoft-des
APP_TIMEZONE=America/Bogota

# ========================================
# CONFIGURACIÓN DE SEGURIDAD
# ========================================
JWT_SECRET=your_jwt_secret_key_here
SESSION_TIMEOUT=1800

# ========================================
# NOTAS IMPORTANTES
# ========================================
# 1. NUNCA compartir este archivo con credenciales reales
# 2. Usar contraseñas de aplicación para Gmail, no la contraseña principal
# 3. Cambiar valores por defecto en producción
# 4. Ver README.md para instrucciones de instalación
